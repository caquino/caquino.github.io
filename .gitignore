vendor/bundle
bin

# Development-only tooling kept out of the public repo.
# Covers the one-shot migration scripts, the AI cover-generation pipeline
# (generate_covers.py / image_prompt.py / briefs.json / audit.json), any
# Python cache, and any ad-hoc helpers under scripts/.
scripts/
__pycache__/
*.pyc
.venv/

# Dev-only Jekyll config; production uses _config.yml alone.
_config.dev.yml

# Local editor / OS junk
.DS_Store
Thumbs.db

# Post cover PNG twins are build-time artifacts: rsvg-convert renders them
# from cover.svg during the GitHub Actions pipeline. Only SVGs are tracked.
# Keep cover-ernie.png (pre-SVG backup) and any other cover-<label>.png files.
images/*/cover.png
